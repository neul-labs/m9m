{
  "name": "m9m-cli",
  "version": "1.0.0",
  "description": "Drop-in n8n alternative in Go — faster, more reliable, no Node.js required. Run n8n workflows unchanged.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --test dist/tests/*.test.js",
    "postinstall": "node dist/postinstall.js || true",
    "prepare": "npm run build"
  },
  "keywords": [
    "workflow",
    "workflow-automation",
    "automation",
    "n8n",
    "n8n-alternative",
    "n8n-replacement",
    "low-code",
    "ipaas",
    "integration-platform",
    "mcp",
    "mcp-server",
    "ai-agents",
    "claude-code",
    "webhook",
    "cron",
    "scheduler",
    "workflow-engine",
    "m9m"
  ],
  "author": "Neul Labs",
  "license": "MIT",
  "homepage": "https://github.com/neul-labs/m9m#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neul-labs/m9m.git",
    "directory": "packages/m9m-cli/nodejs"
  },
  "bugs": {
    "url": "https://github.com/neul-labs/m9m/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
